          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/shipments/00000000-0000-0000-0000-000000000099"
          }
        }
      ]
    },
    {
      "name": "5. Payments",
      "item": [
        {
          "name": "Create Payment Session (real Stripe PaymentIntent)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json().data;",
            "if (data.payment) { pm.collectionVariables.set('paymentId', data.payment.id); }",
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "pm.test('Has real clientSecret', () => pm.expect(data.clientSecret).to.include('secret'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/payments/initiate",
            "body": { "mode": "raw", "raw": "{\n  \"shipmentId\": \"{{shipmentId}}\"\n}" }
          }
        },
        {
          "name": "Payment status BEFORE confirmation -> PENDING",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status field is PENDING', () => pm.expect(pm.response.json().data.status).to.eql('PENDING'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          }
        },
        {
          "name": "Payment status AFTER webhook (previously confirmed) -> PAID",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status field is PAID', () => pm.expect(pm.response.json().data.status).to.eql('PAID'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/payments/{{paidPaymentId}}"
          }
        },
        {
          "name": "Stripe Webhook (called by Stripe, not manually)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "<from-stripe>" }
            ],
            "url": "{{baseUrl}}/payments/webhook",
            "body": { "mode": "raw", "raw": "{ \"note\": \"Sent by Stripe directly during real webhook events - signature verified server-side\" }" }
          }
        }
      ]
    },
