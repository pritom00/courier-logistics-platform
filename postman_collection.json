{
  "info": {
    "name": "Courier & Logistics Management Platform API",
    "description": "Complete API reference and test suite for the Courier & Logistics Management Platform. Organized by resource (matching the README's endpoint map), with every one of the 29 endpoints covered, plus dedicated folders for RBAC-failure demos, validation errors, and standard error responses. Tokens and IDs auto-chain via test scripts - log in once per role and every subsequent request uses the saved token automatically. baseUrl defaults to the live Render deployment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://courier-logistics-platform.onrender.com/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "courierToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "shipmentId", "value": "" },
    { "key": "courierId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "hubId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "paidPaymentId", "value": "1159b89b-8a3a-4708-bdbc-662129cfbee7" }
  ],
  "item": [
    {
      "name": "0. Auth - Setup & Token Lifecycle",
      "item": [
        {
          "name": "Login as Admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json().data;",
            "pm.collectionVariables.set('adminToken', data.accessToken);",
            "pm.collectionVariables.set('refreshToken', data.refreshToken);",
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Has accessToken', () => pm.expect(data.accessToken).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@courierhub.com\",\n  \"password\": \"Admin@12345\"\n}" }
          }
        },
        {
          "name": "Login as Customer",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json().data;",
            "pm.collectionVariables.set('customerToken', data.accessToken);",
            "pm.test('Status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@courierhub.com\",\n  \"password\": \"Customer@123\"\n}" }
          }
        },
        {
          "name": "Login as Courier",
          "event": [{ "listen": "test", "script": { "exec": [
            "const data = pm.response.json().data;",
            "pm.collectionVariables.set('courierToken', data.accessToken);",
            "pm.test('Status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"courier@courierhub.com\",\n  \"password\": \"Courier@123\"\n}" }
          }
        },
        {
          "name": "Register (new user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane-{{$randomInt}}@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"CUSTOMER\"\n}" }
          }
        },
        {
          "name": "Google Login (requires a real Google ID token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/google",
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"<google-id-token-from-client>\"\n}" }
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));",
            "pm.test('Returns a new accessToken', () => pm.expect(pm.response.json().data.accessToken).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh-token",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Logout",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
