    {
      "name": "4. Validation & Error Handling",
      "item": [
        {
          "name": "Validation: invalid email format -> 422",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 422', () => pm.response.to.have.status(422));",
            "pm.test('Structured error shape', () => {",
            "  const json = pm.response.json();",
            "  pm.expect(json.success).to.eql(false);",
            "  pm.expect(json.errors).to.be.an('array');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bad Email User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"Password@123\"\n}" }
          }
        },
        {
          "name": "401 Unauthorized: no token provided",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "404 Not Found: fake shipment ID",
          "event": [{ "listen": "test", "script": { "exec": [
